<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vellum.mapper.PostImageMapper">

    <select id="selectByPostIds" resultType="com.vellum.entity.PostImage">
        SELECT id, post_id, object_name, sort_order, deleted, created_at
        FROM post_image
        WHERE deleted = FALSE
          AND post_id IN
        <foreach collection="postIds" item="postId" open="(" separator="," close=")">
            #{postId}
        </foreach>
        ORDER BY sort_order ASC, created_at ASC
    </select>

</mapper>
